import React, { useState, useEffect, useRef } from 'react';
import { 
  Mic, MicOff, Send, Play, BarChart3, ClipboardList, 
  UserCircle, Building2, Briefcase, ShieldAlert, 
  CheckCircle2, AlertCircle, TrendingUp, Calendar,
  ArrowRight, XCircle, Loader2, Volume2
} from 'lucide-react';

const App = () => {
  // --- STATE MANAGEMENT ---
  const [step, setStep] = useState('setup'); // setup, analysis, interview, report
  const [config, setConfig] = useState({
    role: 'Product Manager',
    company: '',
    persona: 'Tough Consultant',
    jd: '',
    apiKey: '',
    cvName: 'resume_v1.pdf'
  });
  
  const [messages, setMessages] = useState([]);
  const [userInput, setUserInput] = useState('');
  const [isListening, setIsListening] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);
  const [analysisActive, setAnalysisActive] = useState(false);
  const [reportTab, setReportTab] = useState('summary');

  const scrollRef = useRef(null);
  const recognitionRef = useRef(null);

  // --- AUDIO LOGIC (STT/TTS) ---
  useEffect(() => {
    if (typeof window !== 'undefined' && (window.SpeechRecognition || window.webkitSpeechRecognition)) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognitionRef.current = new SpeechRecognition();
      recognitionRef.current.continuous = true;
      recognitionRef.current.interimResults = false;

      recognitionRef.current.onresult = (event) => {
        const transcript = event.results[event.results.length - 1][0].transcript;
        setUserInput(transcript);
        stopListening();
      };

      recognitionRef.current.onerror = () => stopListening();
    }
  }, []);

  const speak = (text) => {
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.rate = 1.0;
    utterance.pitch = 1.0;
    window.speechSynthesis.speak(utterance);
  };

  const startListening = () => {
    try {
      recognitionRef.current?.start();
      setIsListening(true);
    } catch (e) { console.error(e); }
  };

  const stopListening = () => {
    recognitionRef.current?.stop();
    setIsListening(false);
  };

  // --- API INTEGRATION ---
  const getAIResponse = async (chatHistory) => {
    if (!config.apiKey) {
      // Mock Response if no API key
      return "I noticed you mentioned efficiency improvements. In a managerial context, 'improved' is a relative term. What was the exact baseline metric before your intervention, and what was the annualized ROI?";
    }

    const systemPrompt = `You are an elite, highly experienced ${config.persona} conducting a rigorous MBA interview. 
    Role: ${config.role}. Company: ${config.company}. JD Context: ${config.jd}. 
    Core Philosophy: Test business acumen and data orientation. 
    Rules: 1 Question at a time. 2-4 sentences max. Challenge vague metrics. No spoon-feeding. 
    If they answer well, increase difficulty. Use a corporate executive tone.`;

    try {
      const response = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${config.apiKey}`
        },
        body: JSON.stringify({
          model: "gpt-4o-mini",
          messages: [{ role: "system", content: systemPrompt }, ...chatHistory],
          max_tokens: 150
        })
      });
      const data = await response.json();
      return data.choices[0].message.content;
    } catch (error) {
      return "Error connecting to AI. Please check your API key.";
    }
  };

  // --- FLOW HANDLERS ---
  const handleStartAnalysis = () => {
    setStep('analysis');
    setTimeout(() => setAnalysisActive(true), 2000);
  };

  const handleStartInterview = async () => {
    setStep('interview');
    setIsProcessing(true);
    const initialPrompt = `Introduce yourself briefly as a ${config.persona}, acknowledge the candidate's interest in ${config.role} at ${config.company}, and ask a probing first question based on their likely CV strengths.`;
    const firstQuestion = await getAIResponse([{ role: "user", content: initialPrompt }]);
    setMessages([{ role: 'interviewer', text: firstQuestion }]);
    speak(firstQuestion);
    setIsProcessing(false);
  };

  const handleSendMessage = async () => {
    if (!userInput.trim()) return;
    
    const newMessages = [...messages, { role: 'user', text: userInput }];
    setMessages(newMessages);
    setUserInput('');
    setIsProcessing(true);

    const aiResponse = await getAIResponse(newMessages.map(m => ({
      role: m.role === 'interviewer' ? 'assistant' : 'user',
      content: m.text
    })));

    setMessages(prev => [...prev, { role: 'interviewer', text: aiResponse }]);
    speak(aiResponse);
    setIsProcessing(false);
  };

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  // --- SCREENS ---

  const SetupScreen = () => (
    <div className="max-w-4xl mx-auto space-y-8 animate-in fade-in duration-700">
      <div className="text-center space-y-2">
        <h1 className="text-4xl font-bold text-slate-900 tracking-tight">Executive Interview Simulator</h1>
        <p className="text-slate-500">Prepare for the board room, not the classroom.</p>
      </div>

      <div className="bg-white border border-slate-200 rounded-xl shadow-sm p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div className="space-y-4">
          <div>
            <label className="block text-sm font-semibold text-slate-700 mb-1">Target Role</label>
            <select 
              className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500"
              value={config.role}
              onChange={(e) => setConfig({...config, role: e.target.value})}
            >
              <option>Product Manager</option>
              <option>Management Consultant</option>
              <option>Investment Banker</option>
              <option>Operations Head</option>
            </select>
          </div>
          <div>
            <label className="block text-sm font-semibold text-slate-700 mb-1">Target Company</label>
            <input 
              type="text" 
              placeholder="e.g. McKinsey, Google, Goldman Sachs"
              className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500"
              onChange={(e) => setConfig({...config, company: e.target.value})}
            />
          </div>
          <div>
            <label className="block text-sm font-semibold text-slate-700 mb-1">Interviewer Persona</label>
            <div className="grid grid-cols-2 gap-2">
              {['Tough Consultant', 'CEO', 'Hiring Manager', 'HR BP'].map(p => (
                <button 
                  key={p}
                  onClick={() => setConfig({...config, persona: p})}
                  className={`py-2 px-3 text-sm rounded-lg border transition-all ${config.persona === p ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-600 border-slate-200 hover:border-blue-400'}`}
                >
                  {p}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div className="space-y-4">
          <div className="h-full flex flex-col">
            <label className="block text-sm font-semibold text-slate-700 mb-1">Upload Resume (PDF/DOCX)</label>
            <div className="flex-grow border-2 border-dashed border-slate-200 rounded-xl flex flex-col items-center justify-center p-4 hover:bg-slate-50 transition-colors cursor-pointer">
              <Briefcase className="w-8 h-8 text-slate-400 mb-2" />
              <span className="text-sm text-slate-500 font-medium">{config.cvName}</span>
            </div>
          </div>
          <div>
            <label className="block text-sm font-semibold text-slate-700 mb-1">Job Description</label>
            <textarea 
              className="w-full h-32 p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500 text-sm"
              placeholder="Paste the JD here to align the simulation..."
              onChange={(e) => setConfig({...config, jd: e.target.value})}
            />
          </div>
        </div>
        
        <div className="md:col-span-2 pt-4 border-t border-slate-100">
          <div className="flex items-center gap-4">
            <div className="flex-grow">
              <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">OpenAI API Token (Optional)</label>
              <input 
                type="password" 
                placeholder="sk-..."
                className="w-full p-2 bg-slate-900 text-white rounded-lg font-mono text-sm"
                onChange={(e) => setConfig({...config, apiKey: e.target.value})}
              />
            </div>
            <button 
              onClick={handleStartAnalysis}
              className="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg flex items-center gap-2 transition-all h-[44px] mt-5"
            >
              Start Analysis <ArrowRight className="w-4 h-4" />
            </button>
          </div>
        </div>
      </div>
    </div>
  );

  const AnalysisScreen = () => (
    <div className="max-w-5xl mx-auto space-y-6 animate-in slide-in-from-bottom-4 duration-500">
      <div className="bg-slate-900 text-white p-8 rounded-2xl shadow-xl">
        {!analysisActive ? (
          <div className="flex flex-col items-center justify-center py-12 space-y-4">
            <Loader2 className="w-12 h-12 text-blue-400 animate-spin" />
            <h2 className="text-xl font-medium">Deconstructing your profile...</h2>
            <p className="text-slate-400">Our AI is identifying structural weaknesses in your resume.</p>
          </div>
        ) : (
          <div className="space-y-8 animate-in fade-in duration-1000">
            <div className="flex justify-between items-end">
              <div>
                <h2 className="text-2xl font-bold">Pre-Interview Intelligence</h2>
                <p className="text-slate-400">Analysis complete. The interviewer is prepared.</p>
              </div>
              <button 
                onClick={handleStartInterview}
                className="bg-blue-500 hover:bg-blue-400 text-white font-bold py-3 px-8 rounded-lg transition-all"
              >
                Enter Interview Room
              </button>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="bg-slate-800/50 p-6 rounded-xl border border-slate-700">
                <div className="flex items-center gap-2 mb-4 text-red-400">
                  <ShieldAlert className="w-5 h-5" />
                  <h3 className="font-bold uppercase tracking-wider text-sm">CV Interrogation Targets</h3>
                </div>
                <ul className="space-y-3">
                  {['Vague "Efficiency" claims', 'Missing budget oversight figures', 'Generic leadership buzzwords', 'Ambiguous project timelines'].map((t, i) => (
                    <li key={i} className="flex items-center gap-3 text-slate-300 bg-slate-900/50 p-3 rounded-lg border border-slate-700/50">
                      <div className="w-1.5 h-1.5 rounded-full bg-red-500" /> {t}
                    </li>
                  ))}
                </ul>
              </div>

              <div className="bg-slate-800/50 p-6 rounded-xl border border-slate-700">
                <div className="flex items-center gap-2 mb-4 text-blue-400">
                  <TrendingUp className="w-5 h-5" />
                  <h3 className="font-bold uppercase tracking-wider text-sm">Competency Alignment</h3>
                </div>
                <div className="space-y-4">
                  {[
                    { label: 'Strategic Thinking', risk: 'Low' },
                    { label: 'Data Orientation', risk: 'High' },
                    { label: 'Stakeholder Management', risk: 'Medium' }
                  ].map((c, i) => (
                    <div key={i} className="flex items-center justify-between bg-slate-900/50 p-3 rounded-lg">
                      <span className="text-slate-300">{c.label}</span>
                      <span className={`px-2 py-1 rounded text-xs font-bold ${c.risk === 'Low' ? 'bg-green-500/20 text-green-400' : c.risk === 'Medium' ? 'bg-yellow-500/20 text-yellow-400' : 'bg-red-500/20 text-red-400'}`}>
                        {c.risk} RISK
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );

  const InterviewScreen = () => (
    <div className="max-w-4xl mx-auto h-[80vh] flex flex-col bg-white border border-slate-200 rounded-2xl shadow-2xl overflow-hidden">
      {/* Header */}
      <div className="bg-slate-900 p-4 text-white flex justify-between items-center">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center font-bold">
            {config.persona.charAt(0)}
          </div>
          <div>
            <p className="font-bold leading-none">{config.persona}</p>
            <p className="text-xs text-slate-400 mt-1">Simulating Corporate Interview</p>
          </div>
        </div>
        <button 
          onClick={() => setStep('report')}
          className="bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white px-4 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2"
        >
          <XCircle className="w-4 h-4" /> End Interview
        </button>
      </div>

      {/* Chat Area */}
      <div className="flex-grow overflow-y-auto p-6 space-y-6 bg-slate-50">
        {messages.map((m, i) => (
          <div key={i} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'} animate-in fade-in slide-in-from-bottom-2`}>
            <div className={`max-w-[80%] p-4 rounded-2xl ${m.role === 'user' ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-white border border-slate-200 text-slate-800 shadow-sm rounded-tl-none'}`}>
              <p className="text-sm md:text-base leading-relaxed">{m.text}</p>
            </div>
          </div>
        ))}
        {isProcessing && (
          <div className="flex justify-start">
            <div className="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none flex gap-2">
              <div className="w-2 h-2 bg-slate-300 rounded-full animate-bounce" />
              <div className="w-2 h-2 bg-slate-300 rounded-full animate-bounce [animation-delay:0.2s]" />
              <div className="w-2 h-2 bg-slate-300 rounded-full animate-bounce [animation-delay:0.4s]" />
            </div>
          </div>
        )}
        <div ref={scrollRef} />
      </div>

      {/* Controls */}
      <div className="p-4 bg-white border-t border-slate-200">
        <div className="flex items-center gap-3 max-w-3xl mx-auto">
          <button 
            onClick={isListening ? stopListening : startListening}
            className={`p-4 rounded-full transition-all ${isListening ? 'bg-red-500 text-white animate-pulse' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}
          >
            {isListening ? <MicOff /> : <Mic />}
          </button>
          <input 
            type="text" 
            value={userInput}
            onChange={(e) => setUserInput(e.target.value)}
            onKeyPress={(e) => e.key === 'Enter' && handleSendMessage()}
            placeholder="Type your response or use the mic..."
            className="flex-grow p-4 bg-slate-100 border-none rounded-xl focus:ring-2 focus:ring-blue-500 outline-none"
          />
          <button 
            onClick={handleSendMessage}
            disabled={isProcessing}
            className="p-4 bg-blue-600 text-white rounded-full hover:bg-blue-700 disabled:opacity-50"
          >
            <Send className="w-5 h-5" />
          </button>
        </div>
      </div>
    </div>
  );

  const ReportScreen = () => (
    <div className="max-w-5xl mx-auto space-y-6 animate-in zoom-in-95 duration-500">
      <div className="bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
        <div className="bg-slate-900 p-8 text-white">
          <div className="flex justify-between items-center">
            <div>
              <h2 className="text-3xl font-bold">Interview Performance Audit</h2>
              <p className="text-slate-400 mt-2">Candidate Evaluation for {config.role}</p>
            </div>
            <div className="text-center">
              <div className="text-4xl font-black text-blue-400">72%</div>
              <div className="text-xs font-bold uppercase tracking-widest text-slate-500">Readiness Score</div>
            </div>
          </div>
        </div>

        <div className="flex border-b border-slate-200">
          {[
            { id: 'summary', label: 'Executive Summary', icon: <ClipboardList className="w-4 h-4" /> },
            { id: 'mistakes', label: 'Mistake Analysis', icon: <AlertCircle className="w-4 h-4" /> },
            { id: 'scorecard', label: 'Business Scorecard', icon: <BarChart3 className="w-4 h-4" /> },
            { id: 'plan', label: '7-Day Plan', icon: <Calendar className="w-4 h-4" /> }
          ].map(tab => (
            <button 
              key={tab.id}
              onClick={() => setReportTab(tab.id)}
              className={`flex-grow flex items-center justify-center gap-2 py-4 text-sm font-bold transition-all border-b-2 ${reportTab === tab.id ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:bg-slate-50'}`}
            >
              {tab.icon} {tab.label}
            </button>
          ))}
        </div>

        <div className="p-8">
          {reportTab === 'summary' && (
            <div className="space-y-6">
              <div className="p-4 bg-blue-50 border-l-4 border-blue-500 rounded-r-xl">
                <h4 className="font-bold text-blue-900 mb-1">Key Insight</h4>
                <p className="text-blue-800">Strong theoretical knowledge but struggled when pushed on specific ROI metrics for the optimization project mentioned.</p>
              </div>
              <div className="space-y-4">
                <h3 className="font-bold text-slate-800">Transcript Highlights</h3>
                <div className="space-y-2 max-h-60 overflow-y-auto pr-4">
                  {messages.map((m, i) => (
                    <div key={i} className="text-sm p-3 bg-slate-50 rounded-lg">
                      <span className="font-bold uppercase text-xs text-slate-400 mr-2">{m.role}:</span>
                      <span className="text-slate-700">{m.text}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {reportTab === 'mistakes' && (
            <div className="space-y-4">
              {[
                { said: "We improved efficiency by a lot.", better: "We reduced order-processing latency by 22%, saving $40k/month in overhead." },
                { said: "I used a standard framework.", better: "I adapted the MECE framework to account for the unique supply chain bottlenecks we faced." }
              ].map((m, i) => (
                <div key={i} className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="p-4 bg-red-50 border border-red-100 rounded-xl">
                    <p className="text-xs font-bold text-red-500 uppercase mb-2">What you said</p>
                    <p className="text-slate-700 italic">"{m.said}"</p>
                  </div>
                  <div className="p-4 bg-green-50 border border-green-100 rounded-xl">
                    <p className="text-xs font-bold text-green-500 uppercase mb-2">Managerial Approach</p>
                    <p className="text-slate-700 font-medium">{m.better}</p>
                  </div>
                </div>
              ))}
            </div>
          )}

          {reportTab === 'scorecard' && (
            <div className="space-y-6">
              {[
                { label: 'Problem Structuring', score: 85 },
                { label: 'Data Orientation', score: 45 },
                { label: 'Cost Awareness', score: 60 },
                { label: 'Executive Presence', score: 90 }
              ].map((s, i) => (
                <div key={i} className="space-y-2">
                  <div className="flex justify-between text-sm font-bold">
                    <span>{s.label}</span>
                    <span>{s.score}%</span>
                  </div>
                  <div className="w-full h-3 bg-slate-100 rounded-full overflow-hidden">
                    <div 
                      className={`h-full transition-all duration-1000 ${s.score > 70 ? 'bg-green-500' : s.score > 50 ? 'bg-yellow-500' : 'bg-red-500'}`} 
                      style={{ width: `${s.score}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          )}

          {reportTab === 'plan' && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[1, 2, 3, 4, 5, 6, 7].map(day => (
                <div key={day} className="flex gap-4 p-4 border border-slate-100 rounded-xl hover:shadow-md transition-shadow">
                  <div className="w-10 h-10 bg-blue-100 text-blue-600 rounded-full flex-shrink-0 flex items-center justify-center font-bold">
                    {day}
                  </div>
                  <div>
                    <h4 className="font-bold text-slate-800">Day {day}</h4>
                    <p className="text-sm text-slate-500">
                      {day === 1 ? "Re-calculate all metrics on your CV using the 'Rule of Three'." : 
                       day === 2 ? "Practice the STAR method for the 'conflict' question specifically." :
                       "Deep dive into industry specific cost-structures."}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        <div className="p-6 bg-slate-50 border-t border-slate-200 text-center">
          <button 
            onClick={() => setStep('setup')}
            className="text-blue-600 font-bold hover:underline"
          >
            Restart New Simulation
          </button>
        </div>
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-slate-50 p-4 md:p-12 font-sans text-slate-900">
      {step === 'setup' && <SetupScreen />}
      {step === 'analysis' && <AnalysisScreen />}
      {step === 'interview' && <InterviewScreen />}
      {step === 'report' && <ReportScreen />}
    </div>
  );
};

export default App;
